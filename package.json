{
  "name": "agentgov",
  "private": true,
  "version": "0.0.1",
  "description": "Agent Governance Platform — cost enforcement and HITL for LLM agents",
  "scripts": {
    "dev": "pnpm --filter @agentgov/proxy dev",
    "test": "pnpm --filter @agentgov/proxy test",
    "build": "pnpm --filter @agentgov/proxy build"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^22.23.3 || ^24.11.0 || >=26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
