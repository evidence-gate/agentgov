{
  "name": "@agentgov/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for agentgov — 1-line governance for AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "devDependencies": {
    "openai": "^4.104.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "@types/node": "^22.0.0"
  }
}
