// Use wrangler types to regenerate worker-configuration.d.ts after editing
{
  "name": "agentgov-proxy",
  "compatibility_date": "2025-01-01",
  "main": "src/index.ts",

  // Vars are non-secret configuration values.
  // For local dev, override with .dev.vars (do NOT commit .dev.vars).
  // TURSO_DATABASE_URL and TURSO_AUTH_TOKEN must be set as Wrangler secrets in production.
  "vars": {
    "TURSO_DATABASE_URL": "",
    "TURSO_AUTH_TOKEN": "",
    // LLM provider API keys — set actual values in .dev.vars (local) or wrangler secrets (production)
    // NEVER commit real key values here
    "OPENAI_API_KEY": "",
    "ANTHROPIC_API_KEY": "",
    // Alert webhook configuration
    "AGENTGOV_ALERT_WEBHOOK_URL": "",
    // Alert thresholds as comma-separated ratios (default: 80% and 100%)
    "AGENTGOV_ALERT_THRESHOLDS": "0.80,1.00"
  }
}
