// Use wrangler types to regenerate worker-configuration.d.ts after editing
{
  "name": "agentgov-proxy",
  "compatibility_date": "2025-01-01",
  "main": "src/index.ts",

  // Cloudflare Workflows binding for HITL (Human-in-the-Loop) approval queue.
  // HitlWorkflow class must be exported from src/index.ts alongside the Hono app.
  "workflows": [
    {
      "name": "agentgov-hitl",
      "binding": "HITL_WORKFLOW",
      "class_name": "HitlWorkflow"
    }
  ],

  // Vars are non-secret configuration values.
  // For local dev, override with .dev.vars (do NOT commit .dev.vars).
  // TURSO_DATABASE_URL and TURSO_AUTH_TOKEN must be set as Wrangler secrets in production.
  "vars": {
    "TURSO_DATABASE_URL": "",
    "TURSO_AUTH_TOKEN": "",
    // LLM provider API keys — set actual values in .dev.vars (local) or wrangler secrets (production)
    // NEVER commit real key values here
    "OPENAI_API_KEY": "",
    "ANTHROPIC_API_KEY": "",
    "GEMINI_API_KEY": "",
    // Alert webhook configuration
    "AGENTGOV_ALERT_WEBHOOK_URL": "",
    // Alert thresholds as comma-separated ratios (default: 80% and 100%)
    "AGENTGOV_ALERT_THRESHOLDS": "0.80,1.00",
    // HITL TTL — seconds before an unanswered approval auto-denies (default: 72h)
    "AGENTGOV_HITL_TTL_SECONDS": "259200",
    // HITL webhook URL — receives approval request notifications
    "AGENTGOV_HITL_WEBHOOK_URL": "",
    // Slack integration — set in .dev.vars / wrangler secrets for production
    "SLACK_BOT_TOKEN": "",
    "SLACK_CHANNEL_ID": "",
    "SLACK_SIGNING_SECRET": ""
  },

  // Production environment — bindings are non-inheritable in Cloudflare Workers.
  // Every workflows entry and every vars key must be redeclared here.
  // Actual secret values are set via: wrangler secret put <KEY> --env production
  // NEVER put real secret values in this file.
  "env": {
    "production": {
      // Explicit name avoids accidental dev/production Worker collision
      "name": "agentgov-proxy-production",

      // Workflows binding redeclared (non-inheritable from top-level)
      // class_name MUST match the exported class name in src/index.ts
      "workflows": [
        {
          "name": "agentgov-hitl-production",
          "binding": "HITL_WORKFLOW",
          "class_name": "HitlWorkflow"
        }
      ],

      // All 12 vars redeclared — actual secret values set via wrangler secret put --env production
      // Non-secret config vars with stable defaults are kept here; all secrets remain empty string
      "vars": {
        "TURSO_DATABASE_URL": "",
        "TURSO_AUTH_TOKEN": "",
        "OPENAI_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "GEMINI_API_KEY": "",
        "AGENTGOV_ALERT_WEBHOOK_URL": "",
        // Non-secret defaults (safe to commit)
        "AGENTGOV_ALERT_THRESHOLDS": "0.80,1.00",
        "AGENTGOV_HITL_TTL_SECONDS": "259200",
        "AGENTGOV_HITL_WEBHOOK_URL": "",
        "SLACK_BOT_TOKEN": "",
        "SLACK_CHANNEL_ID": "",
        "SLACK_SIGNING_SECRET": ""
      }
    }
  }
}
