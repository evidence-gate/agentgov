{
  "name": "@agentgov/proxy",
  "version": "0.0.1",
  "private": true,
  "description": "agentgov Hono proxy — OpenAI-compatible endpoint with budget enforcement",
  "module": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.config.node.ts",
    "test:workers": "vitest run",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:node": "tsx src/index.node.ts",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "test:startup": "node --test scripts/node-startup.test.mjs",
    "test:chat": "node --test scripts/node-chat.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "~1.4.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.1",
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  }
}
