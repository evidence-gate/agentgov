{
  "name": "@agentgov/proxy",
  "version": "0.0.1",
  "private": true,
  "description": "agentgov Hono proxy — OpenAI-compatible endpoint with budget enforcement",
  "module": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run --config vitest.config.node.ts",
    "test:workers": "vitest run",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:node": "tsx src/index.node.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2",
    "wrangler": "^4"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.7"
  }
}
